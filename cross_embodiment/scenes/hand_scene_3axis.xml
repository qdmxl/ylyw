<?xml version="1.0"?>
<!--
跨本体泛化实验 — 灵巧手 + 3轴笛卡尔臂 + 桌面场景

相较原来的 hand_model.xml 的核心改进：
  1. 新增 X轴 (slide_x) 和 Y轴 (slide_y) 平移
  2. 保留原有 Z轴 (lift_z) + 手腕 pitch/yaw
  3. 共5个手臂自由度：平移X, Y, Z + 旋转pitch, yaw
  4. 物体位置可动态偏移，测试 XY 对齐能力

自由度总计: 5 (手臂) + 10 (手指) = 15 DOF
-->
<mujoco model="ylyw_cross_embodiment_hand_3axis">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81">
    <flag contact="enable"/>
  </option>

  <asset>
    <material name="palm" rgba="0.45 0.45 0.50 1"/>
    <material name="finger" rgba="0.55 0.55 0.60 1"/>
    <material name="object" rgba="0.8 0.3 0.2 1"/>
    <material name="table" rgba="0.4 0.35 0.3 1"/>
    <material name="arm" rgba="0.35 0.35 0.45 1"/>
  </asset>

  <default>
    <geom type="capsule" condim="4" friction="1.5 0.01 0.001"/>
    <joint axis="0 0 1" damping="2.0" armature="0.005" frictionloss="0.01"/>
    <position kp="50" kv="5"/>
  </default>

  <worldbody>
    <light pos="0 0 5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light pos="2 2 4" dir="-1 -1 -2" diffuse="0.8 0.8 0.8"/>
    <light pos="-2 2 3" dir="1 -1 -1" diffuse="0.3 0.3 0.3"/>

    <!-- 桌面和地面 -->
    <geom name="floor" type="plane" size="2 2 0.01" pos="0 0 0"/>
    <geom name="table" type="box" size="0.4 0.4 0.02" pos="0 0 0.72" material="table"/>

    <!-- 俯视摄像头 -->
    <camera name="topview" pos="0 0 1.8" xyaxes="1 0 0 0 1 0" mode="fixed"/>
    <!-- 侧视摄像头（从右前方45°向下看桌面中心） -->
    <camera name="sideview" pos="0.7 0 0.9" xyaxes="0 -1 0 0.707 0 0.707" mode="fixed"/>
    <!-- 手腕第一视角（挂载在palm上，面向物体方向） -->
    <camera name="egocentric" pos="0 0.1 1.0" xyaxes="1 0 0 0 0 1" mode="fixed"/>
    <body name="object" pos="0 0 0.76">
      <freejoint name="obj_free"/>
      <geom name="obj_geom" type="box" size="0.025 0.025 0.025" mass="0.03" material="object"/>
    </body>

    <!-- ============================================================ -->
    <!-- 3轴笛卡尔臂 (XYZ平移) + 手腕 (pitch/yaw旋转)               -->
    <!-- ============================================================ -->
    <body name="arm_base" pos="0 0 1.08">
      <!-- X轴平移（左右） ±80mm -->
      <joint name="slide_x" type="slide" axis="1 0 0" range="-0.08 0.08" damping="0.5"/>
      <geom name="rail_x" type="box" size="0.12 0.01 0.01" pos="0 0 0" rgba="0.6 0.6 0.6 1"/>

      <body name="arm_y" pos="0 0 0">
        <!-- Y轴平移（前后） ±80mm -->
        <joint name="slide_y" type="slide" axis="0 1 0" range="-0.08 0.08" damping="0.5"/>
        <geom name="rail_y" type="box" size="0.01 0.12 0.01" pos="0 0 0" rgba="0.6 0.6 0.6 1"/>

        <body name="arm_z" pos="0 0 0">
          <!-- Z轴升降（上下） 保留原来范围 -->
          <joint name="lift_z" type="slide" axis="0 0 1" range="-0.32 0.15" damping="0.5"/>
          <geom name="lift_rod" type="cylinder" size="0.008 0.02" pos="0 0 0" material="arm"/>

          <!-- ============================================================ -->
          <!-- 手腕（旋转） -->
          <!-- ============================================================ -->
          <body name="wrist" pos="0 0 -0.06">
            <geom name="wrist_joint" type="sphere" size="0.015" rgba="0.3 0.3 0.8 1"/>
            <!-- 俯仰 (pitch)：绕 X 轴，手掌向物体倾斜 -->
            <joint name="wrist_pitch" type="hinge" axis="1 0 0" range="-0.8 0.8" damping="2.0" armature="0.01"/>
            <!-- 偏转 (yaw)：绕 Z 轴，手掌左右摆动 -->
            <joint name="wrist_yaw"   type="hinge" axis="0 0 1" range="-0.6 0.6" damping="2.0" armature="0.01"/>

            <!-- 前伸微调（保留，但主要前伸改为由 slide_y 实现） -->
            <body name="palm_reach" pos="0 0 -0.02">
              <joint name="hand_reach" type="slide" axis="0 0 1" range="-0.02 0.10" damping="5.0"/>
              <geom name="reach_guide" type="box" size="0.003 0.003 0.003" rgba="0.3 0.3 0.5 1"/>

              <!-- ============================================================ -->
              <!-- 手掌 + 手指（保持与原来完全相同） -->
              <!-- ============================================================ -->
              <body name="palm" pos="0 0 0">
                <geom name="palm_geom" type="box" size="0.02 0.03 0.04" material="palm"/>

                <!-- ---- 拇指 (thumb, 2 DOF) ---- -->
                <body name="thumb_proximal" pos="0.01 -0.03 0.0">
                  <geom name="thumb_base" type="sphere" size="0.012" material="finger"/>
                  <joint name="THJ1" type="hinge" axis="0 1 0" range="-0.3 0.5"/>
                  <body name="thumb_distal" pos="0.0 0.0 -0.035">
                    <geom name="thumb_link" type="capsule" fromto="0 0 0 0 0 -0.04" size="0.008" material="finger"/>
                    <joint name="THJ2" type="hinge" axis="1 0 0" range="-0.3 0.6"/>
                    <geom name="thumb_tip" type="sphere" size="0.009" pos="0 0 -0.005" material="finger"/>
                  </body>
                </body>

                <!-- ---- 食指 ---- -->
                <body name="index_proximal" pos="0.015 -0.015 -0.01">
                  <geom name="index_base" type="sphere" size="0.010" material="finger"/>
                  <joint name="FFJ1" type="hinge" axis="1 0 0" range="-0.3 1.5"/>
                  <body name="index_distal" pos="0.0 0.0 -0.04">
                    <geom name="index_link" type="capsule" fromto="0 0 0 0 0 -0.05" size="0.007" material="finger"/>
                    <joint name="FFJ2" type="hinge" axis="1 0 0" range="-0.3 1.5"/>
                    <geom name="index_tip" type="sphere" size="0.007" pos="0 0 -0.005" material="finger"/>
                  </body>
                </body>

                <!-- ---- 中指 ---- -->
                <body name="middle_proximal" pos="0.0 -0.015 -0.01">
                  <geom name="middle_base" type="sphere" size="0.010" material="finger"/>
                  <joint name="MFJ1" type="hinge" axis="1 0 0" range="-0.3 1.5"/>
                  <body name="middle_distal" pos="0.0 0.0 -0.045">
                    <geom name="middle_link" type="capsule" fromto="0 0 0 0 0 -0.055" size="0.007" material="finger"/>
                    <joint name="MFJ2" type="hinge" axis="1 0 0" range="-0.3 1.5"/>
                    <geom name="middle_tip" type="sphere" size="0.007" pos="0 0 -0.005" material="finger"/>
                  </body>
                </body>

                <!-- ---- 无名指 ---- -->
                <body name="ring_proximal" pos="-0.015 -0.015 -0.01">
                  <geom name="ring_base" type="sphere" size="0.010" material="finger"/>
                  <joint name="RFJ1" type="hinge" axis="1 0 0" range="-0.3 1.5"/>
                  <body name="ring_distal" pos="0.0 0.0 -0.04">
                    <geom name="ring_link" type="capsule" fromto="0 0 0 0 0 -0.05" size="0.007" material="finger"/>
                    <joint name="RFJ2" type="hinge" axis="1 0 0" range="-0.3 1.5"/>
                    <geom name="ring_tip" type="sphere" size="0.007" pos="0 0 -0.005" material="finger"/>
                  </body>
                </body>

                <!-- ---- 小指 ---- -->
                <body name="pinky_proximal" pos="-0.02 -0.03 -0.01">
                  <geom name="pinky_base" type="sphere" size="0.009" material="finger"/>
                  <joint name="LFJ1" type="hinge" axis="1 0 0" range="-0.3 1.5"/>
                  <body name="pinky_distal" pos="0.0 0.0 -0.03">
                    <geom name="pinky_link" type="capsule" fromto="0 0 0 0 0 -0.04" size="0.006" material="finger"/>
                    <joint name="LFJ2" type="hinge" axis="1 0 0" range="-0.3 1.5"/>
                    <geom name="pinky_tip" type="sphere" size="0.006" pos="0 0 -0.004" material="finger"/>
                  </body>
                </body>

              </body><!-- palm -->
            </body><!-- palm_reach -->
          </body><!-- wrist -->
        </body><!-- arm_z -->
      </body><!-- arm_y -->
    </body><!-- arm_base -->
  </worldbody>

  <actuator>
    <!-- 3轴笛卡尔臂 -->
    <position name="slide_x" joint="slide_x" kp="500" kv="20"/>
    <position name="slide_y" joint="slide_y" kp="500" kv="20"/>
    <position name="lift_z" joint="lift_z" kp="500" kv="20"/>
    <!-- 手腕 -->
    <position name="wrist_pitch" joint="wrist_pitch" kp="80" kv="8"/>
    <position name="wrist_yaw"   joint="wrist_yaw"   kp="80" kv="8"/>
    <position name="hand_reach"  joint="hand_reach"  kp="200" kv="20"/>
    <!-- 手指 -->
    <position name="THJ1" joint="THJ1" kp="50" kv="5"/>
    <position name="THJ2" joint="THJ2" kp="50" kv="5"/>
    <position name="FFJ1" joint="FFJ1" kp="50" kv="5"/>
    <position name="FFJ2" joint="FFJ2" kp="50" kv="5"/>
    <position name="MFJ1" joint="MFJ1" kp="50" kv="5"/>
    <position name="MFJ2" joint="MFJ2" kp="50" kv="5"/>
    <position name="RFJ1" joint="RFJ1" kp="50" kv="5"/>
    <position name="RFJ2" joint="RFJ2" kp="50" kv="5"/>
    <position name="LFJ1" joint="LFJ1" kp="50" kv="5"/>
    <position name="LFJ2" joint="LFJ2" kp="50" kv="5"/>
  </actuator>

</mujoco>
